{{ ansible_managed | ansible.builtin.comment }}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ app_nom }}
  namespace: {{ app_namespace }}
  labels:
    app: {{ app_nom }}
spec:
  replicas: {{ app_replicas }}
  selector:
    matchLabels:
      app: {{ app_nom }}
  template:
    metadata:
      labels:
        app: {{ app_nom }}
    spec:
      containers:
        - name: {{ app_nom }}
          image: {{ app_image }}
          ports:
            - containerPort: 80
          resources:
            requests:
              cpu: 10m
              memory: 16Mi
            limits:
              cpu: 200m
              memory: 128Mi
          readinessProbe:
            httpGet:
              path: /
              port: 80
            initialDelaySeconds: 3
---
apiVersion: v1
kind: Service
metadata:
  name: {{ app_nom }}
  namespace: {{ app_namespace }}
spec:
  selector:
    app: {{ app_nom }}
  ports:
    - port: 80
      targetPort: 80
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ app_nom }}
  namespace: {{ app_namespace }}
spec:
  rules:
    - host: {{ app_nom }}.{{ app_domaine }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ app_nom }}
                port:
                  number: 80
